# Security headers on every page and file (2026-10-23, Martin: "tighten up app security").
#   nosniff            a file is only ever run as the type it's served as
#   Referrer-Policy    other sites see only "app.averages.io", never a page's address (which can hold ids)
#   X-Frame-Options / frame-ancestors   no other site can show the app inside a frame (clickjacking)
#   HSTS               browsers only ever use https for app.averages.io (one year)
#   Permissions-Policy camera, microphone, location, payments and devices are off: the app uses none of them
#   CSP                no <base> tag tricks, no plugins, forms only post to the app, every request upgraded to https
# The CSP leaves scripts and styles alone on purpose: the pages run their own inline code
# (see LegacyPage), and Google/Microsoft sign-in, Typekit and the API all need to keep working.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), browsing-topics=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Let browsers keep the app's own built files (2026-10-14).
# Everything under /_next/static/ has a hash of its content in its file name,
# so a changed file always gets a new name and a new address. Marking these
# "keep for a year, never re-check" is safe, and saves the "has this changed?"
# request for each of them on every page after the first.
# Pages and everything else keep Cloudflare's default (check every time).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Our own scripts (2026-10-20). Every page asks for them by an address with a
# version in it (/js/averages-bell.js?v=...; see scripts/port-pages.mjs), so a
# changed file always has a new address and this is as safe as /_next/static.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# JSZip and pdf.js (2026-10-23), pdf-lib and fontkit (2026-11-12): the version is in the folder name, so these never change in place.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The report card's page design and fonts (2026-11-12): the version is in the folder name (/report/v1/),
# so a changed design goes in /report/v2/ and these never change in place.
/report/*
  Cache-Control: public, max-age=31536000, immutable

# The picture check (2026-11-09): Fullscreen Settings runs /scan in a hidden frame on our own pages, and
# frame-ancestors 'none' above blocked it ("Photo scans are not working in fs"). Only this page may be framed,
# and only by app.averages.io itself; every other site still can't.
/scan
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
/scan.html
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
