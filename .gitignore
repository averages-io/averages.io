# dependencies and build output
node_modules/
.next/
out/
.wrangler/
next-env.d.ts

# secrets: never commit these (use `npx wrangler secret put NAME` instead)
.env
.env.*
.dev.vars
.dev.vars.*

# generated by scripts/port-pages.mjs on every build (edit pages-src/ instead)
app/page.tsx
app/*/page.tsx
app/page.css
app/*/page.css
app/*/*/page.css
app/not-found.css
# hand-written routes (not generated)
!app/signout/page.tsx
app/not-found.tsx

# built from fs-src/ by scripts/build-fs.mjs on every build (2026-10-28; /IS/ since 10-30, /fs/ moves there)
public/IS/
public/fs/
